# ---- Copy to .env and fill in. Never commit the real .env. ----

# Phase 2: Anthropic (the brains)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 1: OpenAI Whisper transcription
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1

# Phase 1: Source content.
# PREFERRED — local-folder mode (no Google auth needed). Point this at any directory.
# For Drive sync, put it inside H:\My Drive\... and File Stream handles cloud sync for free.
INGEST_SOURCE_DIR=H:\My Drive\MarTech portfolio\Multiplier\MarTech\source

# FALLBACK — Drive API mode. Only used if INGEST_SOURCE_DIR is empty.
# Service-account JSON; share the watch folder with the SA email.
GOOGLE_CREDENTIALS_JSON=./credentials/google_service_account.json
DRIVE_SOURCE_FOLDER_ID=

# Phase 3: Airtable approval portal
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Content Multiplier

# Phase 4: Distribution via Buffer GraphQL API (https://developers.buffer.com)
# API key from https://publish.buffer.com/settings/api  (or an OAuth access token)
BUFFER_API_KEY=
# Map each module's output to a Buffer channel ID (get via the get-channels query).
BUFFER_CHANNEL_ID_LINKEDIN=
BUFFER_CHANNEL_ID_X=
# Newsletter usually isn't a Buffer channel — left blank routes it to the webhook fallback.
BUFFER_CHANNEL_ID_NEWSLETTER=

# Optional generic webhook fallback for channels Buffer can't post to (e.g. newsletter platform)
DISTRIBUTION_WEBHOOK_URL=

# Local working dirs
DOWNLOAD_DIR=./_work/downloads
TRANSCRIPT_DIR=./_work/transcripts

# ---- Web app (app.py) ----
# Admin-only HTTP Basic auth for /stats. Leave WEB_PASSWORD blank in local
# dev to skip auth; set both to non-empty values in production.
WEB_USERNAME=admin
WEB_PASSWORD=

# Email-gate unlock cookie. SECRET_KEY signs the cookie so visitors can't
# forge an unlock without it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left blank, the app generates a random key per process start — cookies
# get invalidated on every restart. Always set this in production.
SECRET_KEY=
UNLOCK_DURATION_DAYS=30

# ---- Per-IP daily rate limit on /generate (Flask-Limiter syntax) ----
# Example: "3 per day", "1 per 10 seconds"
RATE_LIMIT_DAILY=3 per day

# ---- Daily cost ceiling (global, across all users) ----
# Both checked on every request; whichever trips first returns 429.
DAILY_MAX_GENERATIONS=50
DAILY_MAX_USD=5.00
# Flat per-submission cost estimate (used to project against DAILY_MAX_USD).
# Roughly: transcript synth + 3 transforms + occasional X repair ≈ $0.05-0.10.
COST_PER_GENERATION_USD=0.08

# ---- Cost monitoring & alerting (from /stats) ----
# Cost is estimated by counting Airtable history rows × COST_PER_GENERATION_USD.
# Set MONTHLY_ALERT_USD > 0 to enable threshold tracking; alert fires once per
# calendar month via the webhook URL if set. Leave both blank to disable.
MONTHLY_ALERT_USD=20.00
MONTHLY_ALERT_WEBHOOK_URL=

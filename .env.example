# ---- Copy to .env and fill in. Never commit the real .env. ----

# Phase 2: Anthropic (the brains)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 1: OpenAI Whisper transcription
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1

# Phase 1: Source content.
# PREFERRED — local-folder mode (no Google auth needed). Point this at any directory.
# For Drive sync, put it inside H:\My Drive\... and File Stream handles cloud sync for free.
INGEST_SOURCE_DIR=H:\My Drive\MarTech portfolio\Multiplier\MarTech\source

# FALLBACK — Drive API mode. Only used if INGEST_SOURCE_DIR is empty.
# Service-account JSON; share the watch folder with the SA email.
GOOGLE_CREDENTIALS_JSON=./credentials/google_service_account.json
DRIVE_SOURCE_FOLDER_ID=

# Phase 3: Airtable approval portal
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Content Multiplier

# Phase 4: Distribution via Buffer GraphQL API (https://developers.buffer.com)
# API key from https://publish.buffer.com/settings/api  (or an OAuth access token)
BUFFER_API_KEY=
# Map each module's output to a Buffer channel ID (get via the get-channels query).
BUFFER_CHANNEL_ID_LINKEDIN=
BUFFER_CHANNEL_ID_X=
# Newsletter usually isn't a Buffer channel — left blank routes it to the webhook fallback.
BUFFER_CHANNEL_ID_NEWSLETTER=

# Optional generic webhook fallback for channels Buffer can't post to (e.g. newsletter platform)
DISTRIBUTION_WEBHOOK_URL=

# Local working dirs
DOWNLOAD_DIR=./_work/downloads
TRANSCRIPT_DIR=./_work/transcripts

# ---- Web app (app.py) ----
# Leave WEB_PASSWORD blank for local-only dev (auth disabled when blank).
# When deployed, set BOTH to non-empty values.
WEB_USERNAME=admin
WEB_PASSWORD=
